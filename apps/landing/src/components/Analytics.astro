---
// biome-ignore-all lint/correctness/noUnusedVariables: the Astro template below consumes `script` via set:html.
// Full PostHog web SDK for the landing site, loaded through the e.snapotter.com
// proxy: autocapture, session replay, heatmaps, dead clicks, web vitals. What
// gets captured is decided in packages/shared/src/analytics/public-site.ts and
// shared with the docs site. Emitted ONLY when PUBLIC_POSTHOG_KEY is set at
// build time (the deploy workflow passes it), so forks and PR previews carry
// nothing; the Playwright harness passes a placeholder key aimed at an
// unroutable host so tests/e2e-landing/analytics-snippet.spec.ts can check
// the emitted pages. CTA clicks arrive through autocapture; name them as
// PostHog Actions, no code needed.
//
// This is a STANDALONE acquisition funnel: a self-hosted app instance mints its
// own anonymous id, so landing -> app cannot be joined; correlate landing
// conversions to fleet growth via the app's instance_started event instead.
import { publicSiteAnalyticsScript } from "@snapotter/shared";

const script = publicSiteAnalyticsScript({
  key: import.meta.env.PUBLIC_POSTHOG_KEY ?? "",
  host: import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com",
});
---

{script && <script is:inline set:html={script} />}
