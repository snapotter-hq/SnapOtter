---
// biome-ignore-all lint/correctness/noUnusedVariables: Astro template consumes frontmatter values.
import { t } from "@/i18n";
import { enOnlyHref, localizeHref } from "@/lib/i18n-page";
import { formatCompact, getStarCount } from "@/lib/stats";

interface Props {
  locale?: string;
}
const { locale = "en" } = Astro.props;

// Fetched at build time; refreshed by the scheduled landing rebuild.
const starCount = formatCompact(await getStarCount());

type NavItem = { label: string; href: string; external?: boolean; desc?: string };
const productLinks: NavItem[] = [
  {
    label: t(locale, "nav.product.developers.label"),
    href: enOnlyHref("/self-hosted/file-conversion-api"),
    desc: t(locale, "nav.product.developers.desc"),
  },
  {
    label: t(locale, "nav.product.selfHosted.label"),
    href: enOnlyHref("/self-hosted"),
    desc: t(locale, "nav.product.selfHosted.desc"),
  },
  {
    label: t(locale, "nav.product.alternatives.label"),
    href: localizeHref(locale, "/alternatives"),
    desc: t(locale, "nav.product.alternatives.desc"),
  },
];
const links: NavItem[] = [
  { label: t(locale, "nav.enterprise"), href: localizeHref(locale, "/#enterprise") },
  { label: t(locale, "nav.pricing"), href: localizeHref(locale, "/#pricing") },
  { label: t(locale, "nav.docs"), href: "https://docs.snapotter.com", external: true },
  { label: t(locale, "nav.talkToHuman"), href: localizeHref(locale, "/contact") },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background/90 backdrop-blur-xl after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:bg-gradient-to-r after:from-transparent after:via-primary/20 after:to-transparent">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" data-nav-row>
    <!-- Logo -->
    <a href={localizeHref(locale, "/")} class="flex shrink-0 items-center gap-2.5">
      <!-- Decorative: the adjacent span already gives the link its accessible name. -->
      <img src="/logo.png" alt="" class="h-8 w-8" width="32" height="32" />
      <span class="font-display text-lg font-bold tracking-tight">SnapOtter</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden items-center gap-6 lg:flex">
      <!-- Product dropdown: hover opens it, and a click toggles data-open (see the
           script below). It used to open on :focus-within instead, but Safari
           doesn't focus a button on mouse click, so clicks did nothing there (#5080).
           Escape sets data-dismissed to hide a hover-opened panel until the pointer
           leaves or a click reopens it (WCAG 1.4.13). The panel is a list of links, so the button is a
           disclosure with no aria-haspopup (#5183). -->
      <div class="group relative" data-product-menu>
        <button
          type="button"
          class="flex items-center gap-1 whitespace-nowrap text-sm font-medium text-muted transition-colors hover:text-foreground group-data-[open]:text-foreground"
          aria-expanded="false"
          aria-controls="product-menu"
        >
          {t(locale, "nav.product")}
          <svg class="h-4 w-4 transition-transform group-hover:group-not-data-[dismissed]:rotate-180 group-data-[open]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <!-- pt clears the button-to-navbar-bottom gap so the panel opens below the
             navbar's bottom border line instead of overlapping up through it. -->
        <div id="product-menu" class="absolute left-0 top-full hidden pt-8 group-hover:group-not-data-[dismissed]:block group-data-[open]:block">
          <div class="w-64 rounded-xl border border-border bg-surface p-2 shadow-lg">
            {productLinks.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-3 py-2 transition-colors hover:bg-background-alt"
              >
                <span class="block text-sm font-semibold text-foreground">{item.label}</span>
                <span class="mt-0.5 block text-xs text-muted">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      {links.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap text-sm font-medium text-muted transition-colors hover:text-foreground"
          {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTAs -->
    <div class="hidden shrink-0 items-center gap-3 md:flex">
      <a
        href="https://github.com/snapotter-hq/snapotter"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center overflow-hidden rounded-lg border border-border text-sm font-medium transition-colors hover:bg-background-alt"
        aria-label={`${t(locale, "home.openSource.star")} (${starCount})`}
        data-star-button
      >
        <span class="flex items-center gap-1.5 px-3 py-1.5 group-data-[compact]:px-2">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span class="whitespace-nowrap group-data-[compact]:hidden">{t(locale, "nav.star")}</span>
        </span>
        <span class="flex items-center gap-1 self-stretch border-s border-border px-2.5 group-data-[compact]:px-2">
          <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span class="text-xs">{starCount}</span>
        </span>
      </a>
      <a
        href={localizeHref(locale, "/contact")}
        class="whitespace-nowrap rounded-lg border border-border px-4 py-1.5 text-sm font-medium transition-colors hover:bg-background-alt"
      >
        {t(locale, "nav.bookDemo")}
      </a>
      <a
        href="https://docs.snapotter.com/guide/getting-started.html"
        data-cta="install"
        data-cta-location="nav"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary whitespace-nowrap rounded-lg px-4 py-1.5 text-sm font-semibold"
      >
        {t(locale, "nav.install")}
      </a>
    </div>

    <!-- Mobile menu toggle. A real button: the old label-for-hidden-checkbox
         wasn't keyboard reachable, never swapped to the close icon, and logged
         every tap as two clicks, which PostHog read as rage clicks (#5011). -->
    <button
      type="button"
      id="mobile-menu-button"
      class="cursor-pointer text-muted lg:hidden"
      aria-label={t(locale, "nav.toggleMenu")}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="menu-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="menu-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-border bg-surface px-6 py-4 lg:hidden">
    {[...productLinks, ...links].map((item) => (
      <a
        href={item.href}
        class="block py-2.5 text-sm font-medium text-muted transition-colors hover:text-foreground"
        {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >
        {item.label}
      </a>
    ))}
    <div class="mt-3 flex flex-col gap-2">
      <a
        href="https://github.com/snapotter-hq/snapotter"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium"
      >
        {t(locale, "home.openSource.star")}
        <span class="flex items-center gap-1 text-xs text-muted">
          <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {starCount}
        </span>
      </a>
      <a
        href={localizeHref(locale, "/contact")}
        class="block rounded-lg border border-border px-4 py-2 text-center text-sm font-medium"
      >
        {t(locale, "nav.bookDemo")}
      </a>
      <a
        href="https://docs.snapotter.com/guide/getting-started.html"
        data-cta="install"
        data-cta-location="nav-mobile"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary block rounded-lg px-4 py-2 text-center text-sm font-semibold"
      >
        {t(locale, "nav.install")}
      </a>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  if (menuButton && menu) {
    menuButton.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("hidden", !open);
      menuButton.querySelector(".menu-open")?.classList.toggle("hidden", open);
      menuButton.querySelector(".menu-close")?.classList.toggle("hidden", !open);
    });
  }

  const productMenu = document.querySelector<HTMLElement>("[data-product-menu]");
  const productButton = productMenu?.querySelector("button");
  if (productMenu && productButton) {
    const setOpen = (open: boolean) => {
      productButton.setAttribute("aria-expanded", String(open));
      productMenu.toggleAttribute("data-open", open);
      if (open) productMenu.removeAttribute("data-dismissed");
    };
    productButton.addEventListener("click", () => {
      setOpen(productButton.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("click", (event) => {
      if (!productMenu.contains(event.target as Node)) setOpen(false);
    });
    // A null relatedTarget is a click on something unfocusable, like the panel's
    // padding; the document click handler above already covers clicks outside.
    productMenu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !productMenu.contains(next)) setOpen(false);
    });
    productMenu.addEventListener("mouseleave", () => {
      productMenu.removeAttribute("data-dismissed");
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const hovered = productMenu.matches(":hover");
      if (!hovered && productButton.getAttribute("aria-expanded") !== "true") return;
      setOpen(false);
      if (hovered) productMenu.setAttribute("data-dismissed", "");
      if (productMenu.contains(document.activeElement)) productButton.focus();
    });
  }

  // Some locales leave no room for the Star label beside the nav links, so drop
  // it (keeping the octocat and count) whenever the row would overflow.
  const row = document.querySelector<HTMLElement>("[data-nav-row]");
  const star = document.querySelector<HTMLElement>("[data-star-button]");
  if (row && star) {
    const fit = () => {
      delete star.dataset.compact;
      if (row.scrollWidth > row.clientWidth) star.dataset.compact = "";
    };
    fit();
    window.addEventListener("resize", fit);
  }
</script>
