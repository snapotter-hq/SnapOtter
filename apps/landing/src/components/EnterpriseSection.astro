---
// biome-ignore-all lint/correctness/noUnusedVariables: Astro template consumes frontmatter values.
// biome-ignore-all lint/correctness/noUnusedImports: Astro template consumes frontmatter imports.
import { t } from "@/i18n";
import { localizeHref } from "@/lib/i18n-page";

interface Props {
  locale?: string;
}
const { locale = "en" } = Astro.props;
---

<section class="section-dark bg-noise relative overflow-hidden px-6 py-16 md:py-20" id="enterprise">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-96 max-w-3xl rounded-full bg-primary/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <div class="reveal">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-primary-light">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        {t(locale, "home.enterprise.badge")}
      </span>
      <h2 class="mt-6 font-display text-3xl font-bold tracking-tight text-dark-fg sm:text-4xl">
        {t(locale, "home.enterprise.title")}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-dark-muted">
        {t(locale, "home.enterprise.subtitle")}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={localizeHref(locale, "/enterprise")} class="btn-primary inline-block rounded-xl px-8 py-3 text-base font-semibold">
          {t(locale, "home.enterprise.learnMore")}
        </a>
        <a href={localizeHref(locale, "/contact")} class="btn-outline inline-block rounded-xl px-8 py-3 text-base font-semibold">
          {t(locale, "home.enterprise.bookDemo")}
        </a>
      </div>
      <p class="mt-4 text-sm text-dark-muted">{t(locale, "home.enterprise.ctaBody")}</p>
    </div>
  </div>
</section>
