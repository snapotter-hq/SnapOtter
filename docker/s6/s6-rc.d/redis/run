#!/command/with-contenv sh
. /usr/local/bin/embedded-lib.sh
# A secured install's requirepass lives in this file, never on the command line.
REDIS_CONF=/run/snapotter-redis.conf
write_embedded_redis_conf "$REDIS_CONF" /data/.secrets || exit 1
chown snapotter:snapotter "$REDIS_CONF" || exit 1
exec s6-setuidgid snapotter redis-server "$REDIS_CONF" \
  --dir /data/redis \
  --bind 127.0.0.1 \
  --port "${EMBEDDED_REDIS_PORT:-6379}" \
  --maxmemory-policy noeviction \
  --appendonly yes \
  --maxmemory "${REDIS_MAXMEMORY:-512mb}"
