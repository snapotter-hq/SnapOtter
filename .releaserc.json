{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/sync-version.sh ${nextRelease.version}",
        "publishCmd": "echo '${nextRelease.version}' > .release-version"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "pnpm-lock.yaml",
          "CHANGELOG.md",
          ".release-notes.md",
          ".release-notes/*.md",
          "apps/web/package.json",
          "apps/api/package.json",
          "apps/demo/package.json",
          "apps/docs/package.json",
          "apps/landing/package.json",
          "apps/docs/**/guide/getting-started.md",
          "apps/docs/**/guide/security.md",
          "apps/docs/changelog.md",
          "packages/shared/package.json",
          "packages/shared/src/constants.ts",
          "packages/doc-engine/package.json",
          "packages/enterprise/package.json",
          "packages/image-engine/package.json",
          "packages/media-engine/package.json",
          "packages/ai/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "successCommentCondition": false,
        "releasedLabels": false
      }
    ]
  ]
}
