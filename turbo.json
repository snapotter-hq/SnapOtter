{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ANALYTICS_BAKED_OVERRIDE", "SENTRY_CRON_MONITORS"],
  "globalPassThroughEnv": [
    "API_URL",
    "E2E_PG_BASE_URL",
    "PLAYWRIGHT_API_PORT",
    "PLAYWRIGHT_API_URL",
    "PLAYWRIGHT_AUTH_FILE",
    "PLAYWRIGHT_DOCS_PORT",
    "PLAYWRIGHT_LANDING_PORT",
    "PLAYWRIGHT_RUN_ID",
    "PLAYWRIGHT_RUN_ROOT",
    "PLAYWRIGHT_WEB_PORT",
    "PLAYWRIGHT_WEB_URL",
    "PW_WORKERS",
    "REDIS_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
