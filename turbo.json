{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ANALYTICS_BAKED_OVERRIDE", "SENTRY_CRON_MONITORS"],
  "globalPassThroughEnv": [
    "API_URL",
    "CAIRE_PATH",
    "E2E_PG_BASE_URL",
    "EDITOR_TEST_PORT",
    "FULL_MATRIX",
    "FUZZ",
    "FUZZ_RUNS",
    "FUZZ_SEED",
    "LANG",
    "DATA_DIR",
    "DISPATCHER_MAX_REQUESTS",
    "MODELS_PATH",
    "PLAYWRIGHT_API_PORT",
    "PLAYWRIGHT_API_URL",
    "PLAYWRIGHT_AUTH_FILE",
    "PLAYWRIGHT_DEMO_PORT",
    "PLAYWRIGHT_DEMO_URL",
    "PLAYWRIGHT_DOCS_PORT",
    "PLAYWRIGHT_DOCS_URL",
    "PLAYWRIGHT_EDITOR_API_PORT",
    "PLAYWRIGHT_EDITOR_API_URL",
    "PLAYWRIGHT_EDITOR_WEB_PORT",
    "PLAYWRIGHT_EDITOR_WEB_URL",
    "PLAYWRIGHT_LANDING_PORT",
    "PLAYWRIGHT_LANDING_URL",
    "PLAYWRIGHT_RUN_ID",
    "PLAYWRIGHT_RUN_ROOT",
    "PLAYWRIGHT_WEB_PORT",
    "PLAYWRIGHT_WEB_URL",
    "PW_WORKERS",
    "PROCESSING_TIMEOUT_S",
    "PYTHON_VENV_PATH",
    "QA_BASE_URL",
    "QA_BROWSER_CHANNEL",
    "QA_BUNDLES",
    "QA_CONTAINER_NAME",
    "QA_EXPECT",
    "QA_IMAGE_FIXTURE",
    "QA_JOB_TIMEOUT_MS",
    "QA_OUT",
    "QA_PASSWORD",
    "QA_PROFILE",
    "QA_REQUEST_TIMEOUT_MS",
    "QA_RETRIES",
    "QA_SHOT_DIR",
    "QA_USERNAME",
    "QA_WORKERS",
    "REDIS_URL",
    "REQUIRE_AI_FEATURES",
    "U2NET_HOME"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
