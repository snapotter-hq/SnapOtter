{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@snapotter/shared": ["packages/shared/src/index.ts"],
      "@snapotter/shared/*": ["packages/shared/src/*"],
      "@snapotter/enterprise": ["packages/enterprise/src/index.ts"],
      "@snapotter/image-engine": ["packages/image-engine/src/index.ts"],
      "@snapotter/media-engine": ["packages/media-engine/src/index.ts"],
      "@snapotter/doc-engine": ["packages/doc-engine/src/index.ts"],
      "@snapotter/ai": ["packages/ai/src/index.ts"],
      "@aws-sdk/client-s3": ["packages/enterprise/node_modules/@aws-sdk/client-s3"],
      "*": ["apps/api/node_modules/@types/*", "apps/api/node_modules/*"]
    }
  },
  "include": [
    "tests/helpers/**/*",
    "tests/setup/**/*",
    "tests/e2e-analytics/**/*",
    "tests/e2e-demo/**/*",
    "tests/e2e-docker/**/*",
    "tests/e2e-docs/**/*",
    "tests/e2e-editor/**/*",
    "tests/e2e-landing/**/*",
    "tests/e2e-noauth/**/*",
    "tests/e2e/**/*",
    "tests/integration/**/*",
    "tests/qa/**/*",
    "tests/types/**/*",
    "tests/unit/*.ts",
    "tests/unit/*.mts",
    "tests/unit/ai/**/*",
    "tests/unit/api/**/*",
    "tests/unit/docs/**/*",
    "tests/unit/features/**/*",
    "tests/unit/fixtures/**/*",
    "tests/unit/image-engine/**/*",
    "tests/unit/infra/**/*",
    "tests/unit/landing/**/*",
    "tests/unit/scripts/**/*",
    "tests/unit/security/**/*",
    "tests/*.ts",
    "tests/*.mts",
    "tests/benchmark/**/*",
    "tests/unit/doc-engine/**/*",
    "tests/unit/docker/**/*",
    "tests/unit/helpers/**/*",
    "tests/unit/media-engine/**/*",
    "tests/unit/qa/**/*",
    "tests/unit/shared/**/*"
  ],
  "exclude": ["tests/integration/generated/catalog-integrity.test.ts"]
}
