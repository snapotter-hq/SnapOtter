{
  "extends": "./typecheck.tests.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@snapotter/shared": ["packages/shared/src/index.ts"],
      "@snapotter/shared/*": ["packages/shared/src/*"],
      "react-router": ["apps/web/node_modules/react-router/dist/production/index.d.ts"],
      "react-router/dom": ["apps/web/node_modules/react-router/dist/production/dom-export.d.ts"],
      "*": [
        "apps/web/node_modules/@types/*",
        "apps/web/node_modules/*",
        "node_modules/@types/*",
        "node_modules/*"
      ]
    }
  },
  "include": ["tests/unit/web/**/*", "apps/web/src/vite-env.d.ts"]
}
